<!DOCTYPE html>
<html lang="vi" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VELOBOX - Hệ Thống Hộp Nhận Hàng Thông Minh</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Inter & FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            850: '#0f3c20',
                            900: '#14532d',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        @keyframes pulse-slow {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .animate-pulse-slow { animation: pulse-slow 3s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 h-full flex flex-col overflow-hidden">

    <!-- Top Navigation Header -->
    <header class="bg-slate-900 text-white shadow-md z-30 flex-shrink-0">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-brand-500 text-white p-2 rounded-xl shadow-lg flex items-center justify-center w-10 h-10">
                    <i class="fa-solid fa-box-open text-xl"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold tracking-tight text-white flex items-center gap-2">
                        VELOBOX <span class="text-xs bg-brand-500/20 text-brand-400 border border-brand-500/30 px-2 py-0.5 rounded-full font-medium">Smart Locker v3.2</span>
                    </h1>
                    <p class="text-xs text-slate-400 hidden sm:block">Hệ thống Tủ Giao Nhận Hàng Thông Minh Chặng Cuối</p>
                </div>
            </div>

            <!-- Role Switcher & User Profile -->
            <div class="flex items-center space-x-3">
                <div class="relative">
                    <select id="roleSelector" onchange="switchRole(this.value)" class="bg-slate-800 border border-slate-700 text-slate-200 text-xs sm:text-sm rounded-lg focus:ring-brand-500 focus:border-brand-500 block p-2 font-medium cursor-pointer">
                        <option value="resident">👤 Cư dân / Khách hàng</option>
                        <option value="shipper">🚚 Nhân viên giao hàng (Shipper)</option>
                        <option value="admin">⚙️ Quản trị viên (Admin)</option>
                    </select>
                </div>

                <div class="hidden md:flex items-center space-x-2 pl-3 border-l border-slate-700">
                    <div class="w-9 h-9 rounded-full bg-slate-700 flex items-center justify-center text-brand-400 font-bold text-sm border border-slate-600" id="userAvatar">
                        HL
                    </div>
                    <div class="text-left">
                        <div class="text-xs font-semibold text-slate-200" id="userName">Vũ Trần Huyền Linh</div>
                        <div class="text-[10px] text-brand-400" id="userRoleBadge">Cư dân - Căn hộ A-1204</div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <div class="flex-1 flex overflow-hidden">

        <!-- Sidebar Navigation -->
        <aside class="w-20 md:w-64 bg-slate-900/95 border-r border-slate-800 flex flex-col justify-between flex-shrink-0 z-20">
            <nav class="p-3 space-y-1.5" id="sidebarNav">
                <!-- Dynamically populated by JS based on role -->
            </nav>

            <!-- Quick Stats or Station Info in Sidebar -->
            <div class="p-3 m-3 bg-slate-800/80 rounded-xl border border-slate-700/60 hidden md:block">
                <div class="flex items-center justify-between mb-1.5">
                    <span class="text-xs text-slate-400 font-medium">Trạm VELOBOX gần nhất</span>
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                </div>
                <p class="text-xs font-semibold text-slate-200 truncate">Sảnh chính Chung cư Thủy Lợi</p>
                <div class="mt-2 text-[11px] flex justify-between text-slate-400">
                    <span>Trống: <strong class="text-emerald-400">14/24 ô</strong></span>
                    <span>Tải: <strong class="text-amber-400">Ổn định</strong></span>
                </div>
            </div>
        </aside>

        <!-- Dynamic Content Area -->
        <main class="flex-1 bg-slate-100 overflow-y-auto relative" id="mainContentArea">
            <!-- Content loaded via JavaScript based on selected view & role -->
        </main>

    </div>

    <!-- Application JavaScript Logic -->
    <script>
        // Global Application State
        let currentRole = 'resident'; // resident, shipper, admin
        let activeTab = 'dashboard';

        // Mock Database
        const mockData = {
            resident: {
                name: 'Vũ Trần Huyền Linh',
                roleBadge: 'Cư dân - Căn hộ A-1204',
                avatar: 'HL',
                parcels: [
                    { id: 'VB-89214', store: 'Shopee - Thời Trang Nam', locker: 'A-04 (Cỡ M)', status: 'Chờ lấy hàng', time: '14:20 - Hôm nay', code: '849201', qr: true, pin: '4920' },
                    { id: 'VB-88932', store: 'Lazada - Điện Gia Dụng', locker: 'B-01 (Cỡ L)', status: 'Đã nhận thành công', time: 'Hôm qua, 18:35', code: '192847', qr: false, pin: '8392' },
                    { id: 'VB-87210', store: 'TikTok Shop - Sách & Văn Phòng', locker: 'A-02 (Cỡ S)', status: 'Chờ lấy hàng', time: '09:12 - Hôm nay', code: '739201', qr: true, pin: '1049' }
                ],
                stations: [
                    { name: 'VELOBOX Sảnh A - Chung cư Thủy Lợi', address: 'Tầng 1, Tòa A', total: 24, available: 14, status: 'Hoạt động tốt', distance: '0m' },
                    { name: 'VELOBOX Hầm B1 - Khu để xe', address: 'Tầng hầm B1, Tòa B', total: 36, available: 8, status: 'Hoạt động tốt', distance: '120m' },
                    { name: 'VELOBOX Cổng Phụ - Đường Tây Sơn', address: 'Cổng chính khu đô thị', total: 20, available: 3, status: 'Bảo trì định kỳ', distance: '350m' }
                ]
            },
            shipper: {
                name: 'Phạm Ngọc Tuấn Hùng',
                roleBadge: 'Shipper - SPX Express Partner',
                avatar: 'HN',
                deliveries: [
                    { id: 'SPX-99381', recipient: 'Nguyễn Trần Anh (A-0802)', size: 'Cỡ S - Nhỏ', status: 'Sẵn sàng gửi', destination: 'VELOBOX Sảnh A' },
                    { id: 'SPX-99382', recipient: 'Nguyễn Trung Hải (B-1104)', size: 'Cỡ M - Vừa', status: 'Sẵn sàng gửi', destination: 'VELOBOX Sảnh A' },
                    { id: 'SPX-99383', recipient: 'Lê Thị Minh (C-0301)', size: 'Cỡ L - Lớn', status: 'Đã bỏ tủ thành công', destination: 'VELOBOX Hầm B1' }
                ]
            },
            admin: {
                name: 'ThS. Bùi Thị Giang (Admin)',
                roleBadge: 'Quản Trị Viên Hệ Thống VeloBox',
                avatar: 'BG',
                stats: { totalLockers: 3, totalCells: 80, activeParcels: 42, todayRevenue: '450.000 đ' }
            }
        };

        // Navigation Menus per role
        const menus = {
            resident: [
                { id: 'dashboard', label: 'Trang chủ', icon: 'fa-house' },
                { id: 'parcels', label: 'Hộp trực tuyến', icon: 'fa-boxes-packing' },
                { id: 'stations', label: 'Tra cứu Trạm', icon: 'fa-map-location-dot' },
                { id: 'history', label: 'Lịch sử giao dịch', icon: 'fa-clock-rotate-left' },
                { id: 'support', label: 'Hỗ trợ & AI Chat', icon: 'fa-headset' }
            ],
            shipper: [
                { id: 'shipper_dash', label: 'Nhiệm vụ giao hàng', icon: 'fa-truck-fast' },
                { id: 'scan_drop', label: 'Quét & Thả tủ', icon: 'fa-qrcode' },
                { id: 'overdue_pickup', label: 'Thu hồi hàng quá hạn', icon: 'fa-rotate-left' },
                { id: 'shipper_history', label: 'Lịch sử ca làm', icon: 'fa-clipboard-list' }
            ],
            admin: [
                { id: 'admin_dash', label: 'Tổng quan hệ thống', icon: 'fa-chart-pie' },
                { id: 'locker_manage', label: 'Quản lý Trạm & Ô tủ', icon: 'fa-server' },
                { id: 'user_manage', label: 'Quản lý Người dùng', icon: 'fa-users-gear' },
                { id: 'iot_monitoring', label: 'Giám sát IoT & Cảm biến', icon: 'fa-microchip' },
                { id: 'reports', label: 'Báo cáo & Thống kê', icon: 'fa-file-excel' }
            ]
        };

        // Switch role function
        function switchRole(role) {
            currentRole = role;
            const userData = mockData[role];
            
            document.getElementById('userName').innerText = userData.name;
            document.getElementById('userRoleBadge').innerText = userData.roleBadge;
            document.getElementById('userAvatar').innerText = userData.avatar;

            // Set default tab for role
            activeTab = menus[role][0].id;
            renderSidebar();
            renderContent();
        }

        // Render Sidebar Navigation
        function renderSidebar() {
            const nav = document.getElementById('sidebarNav');
            const currentMenus = menus[currentRole];
            
            nav.innerHTML = currentMenus.map(menu => `
                <button onclick="setActiveTab('${menu.id}')" 
                    class="w-full flex items-center space-x-3 px-3 py-3 rounded-xl text-xs sm:text-sm font-medium transition-all ${activeTab === menu.id ? 'bg-brand-600 text-white shadow-lg shadow-brand-900/30 font-semibold' : 'text-slate-400 hover:bg-slate-800 hover:text-slate-200'}">
                    <i class="fa-solid ${menu.icon} w-5 text-center text-base"></i>
                    <span class="hidden md:inline truncate">${menu.label}</span>
                </button>
            `).join('');
        }

        function setActiveTab(tabId) {
            activeTab = tabId;
            renderSidebar();
            renderContent();
        }

        // Render Content based on Role and Active Tab
        function renderContent() {
            const container = document.getElementById('mainContentArea');
            
            if (currentRole === 'resident') {
                if (activeTab === 'dashboard') container.innerHTML = renderResidentDashboard();
                else if (activeTab === 'parcels') container.innerHTML = renderResidentParcels();
                else if (activeTab === 'stations') container.innerHTML = renderResidentStations();
                else if (activeTab === 'history') container.innerHTML = renderResidentHistory();
                else if (activeTab === 'support') container.innerHTML = renderResidentSupport();
            } else if (currentRole === 'shipper') {
                if (activeTab === 'shipper_dash') container.innerHTML = renderShipperDashboard();
                else if (activeTab === 'scan_drop') container.innerHTML = renderShipperScanDrop();
                else if (activeTab === 'overdue_pickup') container.innerHTML = renderShipperOverdue();
                else if (activeTab === 'shipper_history') container.innerHTML = renderShipperHistory();
            } else if (currentRole === 'admin') {
                if (activeTab === 'admin_dash') container.innerHTML = renderAdminDashboard();
                else if (activeTab === 'locker_manage') container.innerHTML = renderAdminLockers();
                else if (activeTab === 'user_manage') container.innerHTML = renderAdminUsers();
                else if (activeTab === 'iot_monitoring') container.innerHTML = renderAdminIoT();
                else if (activeTab === 'reports') container.innerHTML = renderAdminReports();
            }
        }

        // --- RESIDENT VIEWS ---
        function renderResidentDashboard() {
            return `
                <div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto space-y-6">
                    <!-- Welcome Banner -->
                    <div class="bg-gradient-to-r from-brand-850 to-brand-900 rounded-2xl p-6 text-white shadow-xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4 relative overflow-hidden">
                        <div class="absolute right-0 bottom-0 opacity-10 translate-x-10 translate-y-10">
                            <i class="fa-solid fa-box-open text-9xl"></i>
                        </div>
                        <div class="z-10">
                            <span class="bg-brand-500/30 border border-brand-400/30 text-brand-300 text-xs px-3 py-1 rounded-full font-medium">Cư dân thông minh</span>
                            <h2 class="text-2xl sm:text-3xl font-bold mt-2">Xin chào, Vũ Trần Huyền Linh! 👋</h2>
                            <p class="text-slate-300 text-sm mt-1">Bạn có <strong class="text-white">2 bưu kiện</strong> đang chờ lấy tại trạm VELOBOX Sảnh A.</p>
                        </div>
                        <div class="z-10 flex gap-2">
                            <button onclick="setActiveTab('parcels')" class="bg-brand-500 hover:bg-brand-600 text-white font-semibold px-4 py-2.5 rounded-xl text-sm shadow-md transition flex items-center gap-2">
                                <i class="fa-solid fa-qrcode"></i> Mở tủ lấy hàng ngay
                            </button>
                        </div>
                    </div>

                    <!-- Quick Status Cards -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center space-x-4">
                            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold">
                                <i class="fa-solid fa-box"></i>
                            </div>
                            <div>
                                <div class="text-xs text-slate-500 font-medium">Đang chờ nhận</div>
                                <div class="text-xl font-bold text-slate-800">2 Kiện</div>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center space-x-4">
                            <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center text-xl font-bold">
                                <i class="fa-solid fa-check-circle"></i>
                            </div>
                            <div>
                                <div class="text-xs text-slate-500 font-medium">Đã nhận tháng này</div>
                                <div class="text-xl font-bold text-slate-800">18 Kiện</div>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center space-x-4">
                            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl font-bold">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>
                            <div>
                                <div class="text-xs text-slate-500 font-medium">Trạng thái tài khoản</div>
                                <div class="text-sm font-bold text-emerald-600 flex items-center gap-1 mt-0.5">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Đã định danh
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Active Parcels Section -->
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-boxes-stacked text-brand-600"></i> Hộp trực tuyến đang chờ nhận
                            </h3>
                            <button onclick="setActiveTab('parcels')" class="text-xs text-brand-600 font-semibold hover:underline">Xem tất cả</button>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            ${mockData.resident.parcels.filter(p => p.status.includes('Chờ')).map(p => `
                                <div class="border border-slate-200 rounded-xl p-4 bg-slate-50/50 hover:shadow-md transition flex flex-col justify-between">
                                    <div>
                                        <div class="flex justify-between items-start">
                                            <span class="text-xs font-bold text-brand-700 bg-brand-100 px-2.5 py-1 rounded-md">${p.id}</span>
                                            <span class="text-xs text-amber-700 bg-amber-100 px-2.5 py-1 rounded-full font-medium flex items-center gap-1">
                                                <i class="fa-solid fa-clock"></i> ${p.time}
                                            </span>
                                        </div>
                                        <h4 class="font-semibold text-slate-800 text-sm mt-3">${p.store}</h4>
                                        <p class="text-xs text-slate-500 mt-1"><i class="fa-solid fa-location-dot text-rose-500"></i> Vị trí: Tủ Sảnh A - Ô <strong class="text-slate-700">${p.locker}</strong></p>
                                    </div>
                                    <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between">
                                        <div class="text-xs text-slate-600">Mã PIN: <strong class="text-slate-900 tracking-wider font-mono text-sm bg-white px-2 py-0.5 border rounded">${p.pin}</strong></div>
                                        <button onclick="openPickupModal('${p.id}', '${p.pin}')" class="bg-slate-900 hover:bg-slate-800 text-white text-xs font-medium px-3 py-2 rounded-lg shadow transition flex items-center gap-1.5">
                                            <i class="fa-solid fa-qrcode"></i> Lấy hàng ngay
                                        </button>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                </div>
            `;
        }

        function renderResidentParcels() {
            return `
                <div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto space-y-6">
                    <div class="flex justify-between items-center">
                        <div>
                            <h2 class="text-xl font-bold text-slate-900">Quản lý Hộp trực tuyến & Bưu kiện</h2>
                            <p class="text-xs text-slate-500 mt-0.5">Theo dõi chi tiết toàn bộ bưu phẩm và lịch sử lưu trữ tại các trạm VELOBOX.</p>
                        </div>
                        <button onclick="showToast('Đã làm mới dữ liệu Hộp trực tuyến!')" class="bg-white border border-slate-200 text-slate-700 text-xs font-medium px-3 py-2 rounded-xl hover:bg-slate-50 transition shadow-sm">
                            <i class="fa-solid fa-rotate mr-1"></i> Làm mới
                        </button>
                    </div>

                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                        <div class="p-4 border-b border-slate-200 bg-slate-50 flex gap-2">
                            <input type="text" placeholder="Tìm theo mã vận đơn, cửa hàng..." class="bg-white border border-slate-300 text-xs rounded-lg px-3 py-2 w-full sm:w-80 focus:outline-none focus:border-brand-500">
                            <select class="bg-white border border-slate-300 text-xs rounded-lg px-3 py-2 focus:outline-none">
                                <option>Tất cả trạng thái</option>
                                <option>Chờ lấy hàng</option>
                                <option>Đã hoàn thành</option>
                            </select>
                        </div>
                        <div class="divide-y divide-slate-200">
                            ${mockData.resident.parcels.map(p => `
                                <div class="p-4 sm:flex items-center justify-between hover:bg-slate-50/50 transition">
                                    <div class="flex items-start space-x-3">
                                        <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center font-bold flex-shrink-0 mt-0.5">
                                            <i class="fa-solid fa-box"></i>
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <span class="text-xs font-bold text-slate-900">${p.id}</span>
                                                <span class="text-[10px] px-2 py-0.5 rounded-full font-medium ${p.status.includes('Chờ') ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700'}">${p.status}</span>
                                            </div>
                                            <p class="text-xs font-medium text-slate-700 mt-1">${p.store}</p>
                                            <p class="text-[11px] text-slate-500 mt-0.5">Ngăn tủ: <strong>${p.locker}</strong> • Thời gian: ${p.time}</p>
                                        </div>
                                    </div>
                                    <div class="mt-3 sm:mt-0 flex items-center space-x-2">
                                        ${p.status.includes('Chờ') ? `
                                            <button onclick="openPickupModal('${p.id}', '${p.pin}')" class="bg-brand-600 hover:bg-brand-700 text-white text-xs font-medium px-3 py-2 rounded-lg transition shadow-sm">
                                                <i class="fa-solid fa-qrcode mr-1"></i> Mở tủ / Mã PIN
                                            </button>
                                        ` : `
                                            <span class="text-xs text-slate-400 italic">Đã giao thành công</span>
                                        `}
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                </div>
            `;
        }

        function renderResidentStations() {
            return `
                <div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto space-y-6">
                    <div>
                        <h2 class="text-xl font-bold text-slate-900">Mạng lưới Trạm VELOBOX Toàn Khu Vực</h2>
                        <p class="text-xs text-slate-500 mt-0.5">Danh sách các trạm tủ thông minh hoạt động 24/7 xung quanh khu chung cư của bạn.</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        ${mockData.resident.stations.map(s => `
                            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 flex flex-col justify-between">
                                <div>
                                    <div class="flex justify-between items-start">
                                        <span class="text-xs font-bold text-emerald-700 bg-emerald-100 px-2.5 py-1 rounded-md">${s.distance}</span>
                                        <span class="text-xs text-slate-500"><i class="fa-solid fa-signal text-emerald-500"></i> ${s.status}</span>
                                    </div>
                                    <h4 class="font-bold text-slate-900 text-sm mt-3">${s.name}</h4>
                                    <p class="text-xs text-slate-500 mt-1"><i class="fa-solid fa-location-dot text-rose-500 mr-1"></i> ${s.address}</p>
                                </div>
                                <div class="mt-4 pt-3 border-t border-slate-100">
                                    <div class="flex justify-between text-xs text-slate-600 mb-2">
                                        <span>Tổng số ô: <strong>${s.total}</strong></span>
                                        <span>Ô trống: <strong class="text-brand-600">${s.available}</strong></span>
                                    </div>
                                    <button onclick="showToast('Đã đặt làm trạm mặc định thành công!')" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold py-2 rounded-xl transition">
                                        Chọn làm trạm ưu tiên
                                    </button>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
