                container.innerHTML += `
                    <div class="flex items-start space-x-2">
                        <div class="w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-xs font-bold flex-shrink-0">AI</div>
                        <div class="bg-white border border-slate-200 p-3 rounded-2xl text-xs text-slate-700 shadow-sm max-w-md">
                            Cảm ơn bạn đã hỏi. Hệ thống VELOBOX miễn phí lưu trữ trong 24 giờ đầu tiên. Sau 24h, cước phí phát sinh là 5.000đ/12h. Bạn có thể ra trạm Sảnh A quét mã QR để lấy hàng bất cứ lúc nào!
                        </div>
                    </div>
                `;
                container.scrollTop = container.scrollHeight;
            }, 800);
        }

        function simulateSuccessfulDrop() {
            showToast('Thả tủ thành công! Đã gửi mã Zalo ZNS cho cư dân.');
            setTimeout(() => setActiveTab('shipper_dash'), 1500);
        }

        function openPickupModal(parcelId, pinCode) {
            alert(`[MÔ PHỎNG TỦ VELOBOX]\n\nĐã xác thực mã PIN: ${pinCode} cho đơn hàng ${parcelId}.\n\n🔓 Cánh cửa ngăn tủ đã tự động bật mở! Mời bạn lấy hàng và đóng cửa tủ lại.`);
            showToast(`Lấy hàng thành công đơn ${parcelId}!`);
        }

        function showToast(message) {
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-5 right-5 bg-slate-900 text-white text-xs font-medium px-4 py-3 rounded-xl shadow-2xl z-50 flex items-center gap-2 border border-slate-700 animate-bounce';
            toast.innerHTML = `<i class="fa-solid fa-circle-check text-brand-400"></i> ${message}`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        // Initialize on Load
        window.onload = function() {
            renderSidebar();
            renderContent();
        }
    </script>
</body>
</html>
